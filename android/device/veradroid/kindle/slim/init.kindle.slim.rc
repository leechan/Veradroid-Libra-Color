# VeraDroid slim: imported by init.kindle.rc (only the slim products install this file).
# init.kindle.rc and its imports are parsed before /system/etc/init/*.rc and the first definition of a service wins,
# so redefining a stock service here as "disabled" keeps "class_start main" from starting it.

# media.codec / media.drm / media.extractor are only reachable through mediaserver (media.player), which is already
# disabled in init.kindle.rc: three processes (about 5.5 MB PSS) that start while zygote is fighting for the two cores.
# audioserver: started by vd_audio below unless the host started Android without it (/dev/kfb/noaudio, VD_AUDIO=0; framework
# project, docs/framework-project.md). Without that file it starts as before (libmedia of older images waits forever for it).
service mediacodec /system/bin/mediacodec
    class main
    user mediacodec
    group camera drmrpc mediadrm
    disabled

service mediadrm /system/bin/mediadrmserver
    class main
    user media
    group mediadrm drmrpc
    disabled

service mediaextractor /system/bin/mediaextractor
    class main
    user mediaex
    group drmrpc mediadrm
    disabled

# SurfaceFlinger does "ctl.start bootanim" on every boot; bootanimation then loads the whole android runtime just to
# read debug.sf.nobootanimation=1 and exit. Run something that exits at once instead.
service bootanim /system/bin/true
    class core
    user graphics
    group graphics
    disabled
    oneshot

service audioserver /system/bin/audioserver
    class main
    user audioserver
    # media gid needed for /dev/fm (radio) and for /data/misc/media (tee)
    group audio camera drmrpc inet media mediadrm net_bt net_bt_admin net_bw_acct
    ioprio rt 4
    writepid /dev/cpuset/foreground/tasks /dev/stune/foreground/tasks
    disabled

service vd_audio /system/bin/sh -c "[ -e /dev/kfb/noaudio ] || start audioserver"
    class main
    user root
    oneshot
