# 输入：宿主侧的触摸前端 veradroid-input 独占真正的触摸屏，识别全局手势，其余原样转给一块 uinput 虚拟触摸屏，容器读这块。
# 返回 Kindle（冻结）时必须把触摸屏还给 Kindle 界面：给它发 SIGUSR1 释放，再回来时发 SIGUSR2 重新独占，虚拟设备一直在，
# 容器里绑的设备节点不会变。
# 蓝牙输入桥（可选，见 bt.sh）
[ -f "$VD/boot/lib/bt.sh" ] && . "$VD/boot/lib/bt.sh"
input_sysname() {   # $1 = 设备名；打印它的 eventN
    for d in /sys/class/input/input*; do
        [ "$(cat $d/name 2>/dev/null)" = "$1" ] && { ls $d | grep '^event'; return; }
    done
}
input_start() {
    # Firmware 5.19.5 renamed some PW6 touch nodes. Match common FocalTech/Elan/
    # Goodix names, then fall back to the only evdev node that is not a key device.
    REAL=$(input_find 'fts_ts|ft[0-9]|focal|touch|pt_mt|cyttsp|zforce|goodix|elan|synaptics|atmel|cypress|himax|novatek|ilitek|chipone|st16|melfas|zinitix|sec_touchscreen|touchscreen')
    if [ -z "$REAL" ]; then
        REAL=$(awk '/^N: Name=/ { n=$0 } /^H: Handlers=/ { if (n !~ /key|power|hall|gpio|button|volume/) { for (i=1;i<=NF;i++) if (match($i,/event[0-9]+$/)) { print "/dev/input/" substr($i,RSTART); exit } } }' /proc/bus/input/devices)
    fi
    [ -n "$REAL" ] || { t "input: no touch screen"; return 1; }
    t "input: real touch=$REAL"
    [ -x "$VD/bin/veradroid-input" ] || { t "input: veradroid-input missing, passing the raw touch screen through"; type bt_start >/dev/null 2>&1 && bt_start; return 0; }
    case "$(cat /sys/class/input/$(basename "$REAL")/device/name 2>/dev/null)" in
        *goodix*|*Goodix*|*single*)
            # PW5's goodix-ts is single-touch (ABS_X/ABS_Y + BTN_TOUCH), not MT-B.
            # Pass it through; the Android InputReader supports single-touch.
            KFB_TOUCH=$REAL
            chmod 666 "$KFB_TOUCH" 2>/dev/null
            t "input: single-touch goodix -> raw $KFB_TOUCH (gestures disabled)"
            type bt_start >/dev/null 2>&1 && bt_start
            return 0 ;;
    esac
    chmod 666 /dev/input/uinput /dev/uinput 2>/dev/null
    : > $W/input.log
    if [ "$KFB_GESTURES" = 0 ]; then touch $W/nogestures; else rm -f $W/nogestures; fi
    # 四角长按只在真的配了动作时才启用；默认 none 时关掉，否则在角落按住 2 秒会把 Android 的这次长按吞掉
    cm=0
    for g in "$G_TL" "$G_TR" "$G_BL" "$G_BR"; do
        [ -n "$g" ] && [ "$g" != none ] && cm=2000
    done
    gestures_write
    $VD/bin/veradroid-input $REAL $W/input.log $VD/boot/action.sh --w ${viewWidth:-1272} --h ${viewHeight:-1696} --edge 120 --window ${G_WINDOW:-40} --edge-hold 60 --edge-swipe 80 --edge-back ${KFB_EDGE_BACK:-1} --corner-ms $cm --flag $W/nogestures --inject $W/inject --gconf $W/gestures --fg $X/fg >$W/input.err 2>&1 &
    echo $! > $W/input.pid
    i=0; while [ $i -lt 20 ]; do
        vt=$(input_sysname veradroid-touch); vk=$(input_sysname veradroid-keys)
        [ -n "$vt" ] && [ -n "$vk" ] && break
        usleep 200000; i=$((i + 1))
    done
    [ -n "$vt" ] || { t "input: virtual touch screen did not appear"; return 1; }
    KFB_TOUCH=/dev/input/$vt; KFB_KEYS_VIRT=/dev/input/$vk
    chmod 666 $KFB_TOUCH $KFB_KEYS_VIRT
    export KFB_TOUCH KFB_KEYS_VIRT
    t "input: touch $REAL -> $KFB_TOUCH, keys $KFB_KEYS_VIRT"
    type bt_start >/dev/null 2>&1 && bt_start
    return 0
}
input_release() { type bt_release >/dev/null 2>&1 && bt_release; alive $W/input.pid && kill -USR1 "$(cat $W/input.pid)" 2>/dev/null; }
input_grab()    { type bt_grab >/dev/null 2>&1 && bt_grab; alive $W/input.pid && kill -USR2 "$(cat $W/input.pid)" 2>/dev/null; }
input_stop()    { type bt_stop >/dev/null 2>&1 && bt_stop; alive $W/input.pid && kill "$(cat $W/input.pid)" 2>/dev/null; rm -f $W/input.pid; }
