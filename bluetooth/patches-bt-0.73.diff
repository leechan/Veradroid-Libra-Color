--- base/lib_input.sh	2026-11-10 14:20:44.347316270 +0900
+++ patched/input.sh	2026-11-10 14:22:33.809452113 +0900
@@ -1,6 +1,8 @@
 # 输入：宿主侧的触摸前端 veradroid-input 独占真正的触摸屏，识别全局手势，其余原样转给一块 uinput 虚拟触摸屏，容器读这块。
 # 返回 Kindle（冻结）时必须把触摸屏还给 Kindle 界面：给它发 SIGUSR1 释放，再回来时发 SIGUSR2 重新独占，虚拟设备一直在，
 # 容器里绑的设备节点不会变。
+# 蓝牙输入桥（可选，见 bt.sh）
+[ -f "$VD/boot/lib/bt.sh" ] && . "$VD/boot/lib/bt.sh"
 input_sysname() {   # $1 = 设备名；打印它的 eventN
     for d in /sys/class/input/input*; do
         [ "$(cat $d/name 2>/dev/null)" = "$1" ] && { ls $d | grep '^event'; return; }
@@ -15,7 +17,7 @@
     fi
     [ -n "$REAL" ] || { t "input: no touch screen"; return 1; }
     t "input: real touch=$REAL"
-    [ -x "$VD/bin/veradroid-input" ] || { t "input: veradroid-input missing, passing the raw touch screen through"; return 0; }
+    [ -x "$VD/bin/veradroid-input" ] || { t "input: veradroid-input missing, passing the raw touch screen through"; type bt_start >/dev/null 2>&1 && bt_start; return 0; }
     case "$(cat /sys/class/input/$(basename "$REAL")/device/name 2>/dev/null)" in
         *goodix*|*Goodix*|*single*)
             # PW5's goodix-ts is single-touch (ABS_X/ABS_Y + BTN_TOUCH), not MT-B.
@@ -23,6 +25,7 @@
             KFB_TOUCH=$REAL
             chmod 666 "$KFB_TOUCH" 2>/dev/null
             t "input: single-touch goodix -> raw $KFB_TOUCH (gestures disabled)"
+            type bt_start >/dev/null 2>&1 && bt_start
             return 0 ;;
     esac
     chmod 666 /dev/input/uinput /dev/uinput 2>/dev/null
@@ -46,7 +49,9 @@
     chmod 666 $KFB_TOUCH $KFB_KEYS_VIRT
     export KFB_TOUCH KFB_KEYS_VIRT
     t "input: touch $REAL -> $KFB_TOUCH, keys $KFB_KEYS_VIRT"
+    type bt_start >/dev/null 2>&1 && bt_start
+    return 0
 }
-input_release() { alive $W/input.pid && kill -USR1 "$(cat $W/input.pid)" 2>/dev/null; }
-input_grab()    { alive $W/input.pid && kill -USR2 "$(cat $W/input.pid)" 2>/dev/null; }
-input_stop()    { alive $W/input.pid && kill "$(cat $W/input.pid)" 2>/dev/null; rm -f $W/input.pid; }
+input_release() { type bt_release >/dev/null 2>&1 && bt_release; alive $W/input.pid && kill -USR1 "$(cat $W/input.pid)" 2>/dev/null; }
+input_grab()    { type bt_grab >/dev/null 2>&1 && bt_grab; alive $W/input.pid && kill -USR2 "$(cat $W/input.pid)" 2>/dev/null; }
+input_stop()    { type bt_stop >/dev/null 2>&1 && bt_stop; alive $W/input.pid && kill "$(cat $W/input.pid)" 2>/dev/null; rm -f $W/input.pid; }
--- base/lib_container.sh	2026-11-10 14:20:47.211372154 +0900
